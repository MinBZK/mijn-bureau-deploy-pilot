                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.drive.client_id }}": [
              {
                "name": "token-exchange-role",
                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.nextcloud.client_id }}": [
              {
                "name": "token-exchange-role",
                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.docs.client_id }}": [
              {
