                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.openproject.client_id }}": [
              {
                "name": "token-exchange-role",
                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ]
          }
        },
        {{- if eq .Environment.Name "demo" }}
        "users" : [
          {{- $users := .Values.user }}
          {{- range $index, $user := $users }}
          {
            "username" : {{ $user.username | quote }},
            "firstName" : {{ $user.firstname | quote }},
            "lastName" : {{ $user.lastname | quote }},
            "email" : {{ $user.email | quote }},
            "emailVerified" : true,
            "credentials" : [ {
              "type" : "password",
              "value": {{ $user.password | quote }},
              "temporary": false
            } ],
            "enabled" : true
          }{{- if lt $index (sub (len $users) 1) }},{{- end }}
          {{- end }}
        ],
        {{- end }}
        "internationalizationEnabled": true,
        "eventsEnabled": true,
        "eventsExpiration": 86400,
        "adminEventsEnabled": true,
        "supportedLocales": [
          "en",
          "{{ .Values.global.defaultLocale }}"
        ],
        "defaultLocale": "{{ .Values.global.defaultLocale }}"
      }

postgresql:
  enabled: false

externalDatabase:
  host: {{ .Values.database.keycloak.host | quote }}
  port: {{ .StateValues.database.keycloak.port | quote }}
  user: {{ .StateValues.database.keycloak.user | quote }}
  database: {{ .StateValues.database.keycloak.name | quote }}
  password: {{ .StateValues.database.keycloak.password | quote }}


defaultInitContainers:
  prepareWriteDirs:
    containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 6 }}
    resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.keycloak .Values.global.resourcesPreset | quote }}
