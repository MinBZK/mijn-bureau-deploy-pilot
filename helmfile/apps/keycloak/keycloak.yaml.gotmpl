        "defaultRoles": ["offline_access", "uma_authorization", "tokenexchange-role"],
        "roles": {
          "realm": [
            {
              "name": "tokenexchange-role",
              "description": "Allow bureaublad clients to exchange tokens",
              "composite": true,
              "composites": {
                "client": {
                  "{{ .Values.authentication.client.docs.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.openproject.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.nextcloud.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.drive.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.conversations.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.meet.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.synapse.client_id }}": ["token-exchange-role"],
                  "{{ .Values.authentication.client.grist.client_id }}": ["token-exchange-role"]
                }
              },
              "clientRole": false,
              "attributes": {}
            }
          ],
          "client": {
            "{{ .Values.authentication.client.grist.client_id }}": [
              {
                "name": "token-exchange-role",
                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.synapse.client_id }}": [
              {
                "name": "token-exchange-role",
                "description": "",
                "composite": false,
                "clientRole": true,
                "attributes": {}
              }
            ],
            "{{ .Values.authentication.client.meet.client_id }}": [
              {
